    ],
    "description": "Function with camelCase names"
  },
  "CamelCase pytest": {
    "prefix": "ctest",
    "body": [
      "def ${1:testSomething}():",
      "    assert ${0:True}"
    ],
    "description": "camelCase pytest test"
  }
}
